# Copy to .env.local for local development. See DEPLOY.md.

# NextAuth
AUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000

# Google sign-in (Google Cloud Console -> Credentials -> OAuth client ID)
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Optional closed beta: comma-separated allow-list. Empty = anyone with Google.
ALLOWED_EMAILS=

# Must be identical to API_JWT_SECRET in the backend .env
API_JWT_SECRET=

NEXT_PUBLIC_API_URL=http://localhost:8000

# Local development only — password-less sign-in. The code refuses to enable
# this in a production build; do not set either in Vercel.
ALLOW_DEV_LOGIN=true
NEXT_PUBLIC_ALLOW_DEV_LOGIN=true
