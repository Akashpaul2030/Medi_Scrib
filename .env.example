# Copy to .env and fill in. See DEPLOY.md for where each value comes from.

# --- Models ---
DEEPSEEK_API_KEY=
ASSEMBLYAI_API_KEY=

# --- Vector store ---
QDRANT_URL=
QDRANT_API_KEY=
QDRANT_COLLECTION=soap_notes

# --- API auth ---
# Must be identical to API_JWT_SECRET in web/.env.local. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
API_JWT_SECRET=

# --- Limits ---
FREE_MONTHLY_NOTES=10
PAID_MONTHLY_NOTES=150

# --- Billing: Paddle (merchant of record) ---
# Everything stays dormant until PADDLE_API_KEY is set.
# sandbox first, then flip to production
PADDLE_ENV=sandbox
PADDLE_API_KEY=
PADDLE_WEBHOOK_SECRET=
# Client-side token — safe to expose; it can only open a checkout.
PADDLE_CLIENT_TOKEN=
# Created by `python scripts/paddle_setup.py`. Paddle has no inline prices,
# so checkout returns 503 until these are set.
PADDLE_PRICE_FOUNDING=
PADDLE_PRICE_SOLO=
PADDLE_PRICE_PACK_25=
PADDLE_PRICE_PACK_100=

# --- Deployment ---
FRONTEND_URL=http://localhost:3000
# Comma-separated extra CORS origins; localhost:3000/3001 are always allowed.
CORS_ORIGINS=
BILLING_DB=billing.db
